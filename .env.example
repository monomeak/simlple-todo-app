# Used by docker-compose.yml / docker-compose.prod.yml.
# Copy to `.env` in the repo root and fill in real values before running
# `docker compose up`. Never commit the real `.env`.

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=todo

# ---- API (apps/api) ----
API_PORT=3000
JWT_SECRET=change_me_to_a_long_random_secret
CORS_ORIGINS=http://localhost:4000
TYPEORM_SYNCHRONIZE=true
TYPEORM_DROP_SCHEMA=false

# ---- Web (apps/web) ----
WEB_PORT=4000
API_VERSION=v2
# Reachable from the browser -> host-published API port.
NEXT_PUBLIC_API_URL=http://localhost:3000
